<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Codecepticon.Ng</AssemblyName>
    <RootNamespace>Codecepticon</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- Only one Main exists now, so this is belt-and-braces rather than a
         tie-break: it pins the entry point so adding a second Main later fails
         the build loudly instead of silently changing what the tool does. -->
    <StartupObject>Codecepticon.Program</StartupObject>

    <!-- Ported code is pre-nullable. The five files under Ng/ opt in
         per-file with `#nullable enable`. -->
    <Nullable>disable</Nullable>

    <!-- Warnings are VISIBLE but NON-BLOCKING, deliberately.
         ~10,850 lines of 2021-vintage C# warn heavily on a 2026 compiler, and
         most of it is ported code whose behaviour is not yet parity-tested
         (03-porting-plan.md increment 3). Failing the build on those warnings
         would stop the port to fix things that are not known to be wrong.

         What must NOT happen is hiding them: no NoWarn, no reduced
         WarningLevel, and the count is reported on every build. Revisit once
         parity holds - a warning nobody reads is the same as a suppressed one. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <NoWarn></NoWarn>
  </PropertyGroup>

  <!-- ===================================================================
       INVARIANT: the Roslyn Workspaces version below must match the MSBuild
       resolved at run time. This is THE failure mode that killed upstream
       Codecepticon on a Windows CI agent (2026-08-20):

         net472 + Roslyn 3.9.0 (2021) hosting MSBuild 17.14 (2025)
           -> MissingMethodException: FrozenSet.Create        (vs MSBuild 18)
           -> TypeLoadException: ProjectCacheService.DisposeAsync
              has no implementation                           (vs MSBuild 17.14)

       Four distinct failures, each a layer deeper, all one root cause: a pinned
       compiler toolchain hosting a much newer one.

       The alignment below is deliberate and must be bumped as a set, never
       individually. net10.0 is not a preference - it is the ONLY framework the
       whole current stack publishes for: Roslyn 5.9, MSBuild 18.9 and
       PowerShell SDK 7.6 all ship net10.0 assets and nothing older than that
       except netstandard2.0 fallbacks. It is also what VS 2026 installs.

         net10.0  <->  Roslyn 5.9.0  <->  MSBuild 18.9.6  <->  PowerShell 7.6.5

       And have the program REPORT both halves at startup (docs/02-roadmap.md,
       increment 1) so a mismatch is a named error, not a stack trace.
       =================================================================== -->
  <ItemGroup>
    <!-- Runtime assets are NOT excluded here: lib/net10.0/*.dll IS the tool, and
         modern MSBuildWorkspace drives MSBuild out-of-process via the BuildHost
         in this package's contentFiles. Excluding them compiles fine and then
         throws FileNotFoundException on the first workspace open. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />

    <!-- INCREMENT 2: the entire Microsoft.Build.* family and Microsoft.Build.Locator
         are GONE, deliberately. Nothing in this project may reference them again.

         The rule they enforced - "pin exactly one MSBuild and load it before
         anything else" - only exists for a process that hosts MSBuild. This one
         does not: workspaces load through the out-of-process BuildHost, project
         properties are edited as XML (ProjectFile.cs), and builds are a child
         process (ProjectBuilder.cs). Verified 2026-08-21 on Roslyn 5.9.0:
         MSBuildWorkspace.Create() opens both .csproj and .slnx with no locator
         call and no Microsoft.Build assembly present.

         Re-adding any of them re-introduces the version coupling that killed
         upstream. If you think you need one, you need a child process instead. -->

    <!-- PS 5.1 reference assemblies are net472-only. The module uses only
         System.Management.Automation.Language.Parser, which the PowerShell SDK
         provides. Grammar differences between 5.1 and 7.x are a behaviour risk
         to test in increment 3, not an API problem. -->
    <PackageReference Include="System.Management.Automation" Version="7.6.5" />

    <!-- Pinned at 4.9.2 on purpose: Modules/VB6/ANTLR/*.cs was generated by the
         4.9 tool and the runtime must match the generator. 4.9.2 targets
         netstandard2.0, so net10.0 consumes it fine. Bumping to 4.13.x requires
         regenerating all six files from VisualBasic6.g4 first. -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.9.2" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Templates/ holds .cs, .ps1 and .vb6 files that are TEMPLATE TEXT injected
       into obfuscated output - not source. Compiling them is a build error. -->
  <ItemGroup>
    <Compile Remove="Templates\**" />
    <EmbeddedResource Remove="Templates\**" />
    <None Remove="Templates\**" />
    <Compile Remove="Help\**" />
    <EmbeddedResource Remove="Help\**" />
    <None Remove="Help\**" />
  </ItemGroup>

  <!-- Replaces upstream's PostBuild xcopy/rd Exec block, which was cmd.exe-only
       and deleted $(TargetDir) before every build. -->
  <ItemGroup>
    <Content Include="Templates\**" LinkBase="Templates" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Help\**" LinkBase="Help" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CommandLineGenerator.html" Link="CommandLineGenerator.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
